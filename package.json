{
  "name": "kiali",
  "version": "0.1.0",
  "description": "Kiali plugin for Headlamp",
  "license": "Apache-2.0",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "storybook": "headlamp-plugin storybook",
    "storybook-build": "headlamp-plugin storybook-build",
    "test": "headlamp-plugin test",
    "i18n": "headlamp-plugin i18n",
    "parity:check": "node scripts/parity/check-catalog.mjs",
    "resources:generate": "node scripts/generate-resources.mjs",
    "resources:check": "node scripts/generate-resources.mjs --check"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "kubernetes-ui",
    "kubernetes-debugging",
    "plugins"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "overrides": {
    "typescript": "5.6.2"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0"
  },
  "dependencies": {
    "js-yaml": "4.3.2",
    "re2js": "2.8.8"
  },
  "headlamp": {
    "extraDist": {
      "LICENSE": "LICENSE",
      "NOTICE": "NOTICE"
    },
    "i18n": [
      "en"
    ]
  }
}
